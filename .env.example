# ============================================================
# VIIBE Panel — Environment Variables
# ============================================================

# Supabase (públicas)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Supabase (PRIVADA — NUNCA no frontend/cliente)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email — Resend (server-side only)
RESEND_API_KEY=re_sua_api_key
RESEND_FROM_EMAIL=noreply@seudominio.com

# Mercado Pago (server-side only)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-seu-token
MERCADO_PAGO_WEBHOOK_SECRET=sua-webhook-secret
MERCADO_PAGO_PUBLIC_KEY=APP_USR-sua-public-key

# Efí (server-side only)
EFI_CLIENT_ID=seu-client-id
EFI_CLIENT_SECRET=seu-client-secret
EFI_WEBHOOK_SECRET=seu-webhook-secret
